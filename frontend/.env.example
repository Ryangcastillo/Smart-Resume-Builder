# Frontend Environment Configuration

# Development
VITE_NODE_ENV=development

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_GRAPHQL_URL=http://localhost:3001/graphql
VITE_WS_URL=ws://localhost:3001/graphql

# Authentication
VITE_NEON_AUTH_URL=https://your-neon-auth-endpoint
VITE_NEON_AUTH_CLIENT_ID=your-neon-auth-client-id

# Features Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_AI_SUGGESTIONS=true
VITE_ENABLE_REAL_TIME=true

# External Services
VITE_GOOGLE_ANALYTICS_ID=
VITE_SENTRY_DSN=

# Upload Configuration
VITE_MAX_FILE_SIZE=10485760
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx

# UI Configuration
VITE_THEME=light
VITE_BRAND_NAME=ATS Resume Builder