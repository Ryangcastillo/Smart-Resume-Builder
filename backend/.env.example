# Environment Configuration
NODE_ENV=development

# Server Configuration
PORT=3001
HOST=localhost
API_VERSION=v1

# Database Configuration (Neon PostgreSQL)
DATABASE_URL="postgresql://username:password@hostname/database?sslmode=require"
DIRECT_URL="postgresql://username:password@hostname/database?sslmode=require"

# Authentication & Security
JWT_SECRET=your-super-secret-jwt-key-here-min-32-chars
JWT_EXPIRE=7d
BCRYPT_ROUNDS=12

# Neon Auth Configuration
NEON_AUTH_URL=https://your-neon-auth-endpoint
NEON_AUTH_CLIENT_ID=your-neon-auth-client-id
NEON_AUTH_CLIENT_SECRET=your-neon-auth-client-secret

# Redis Configuration (Optional)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# File Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_PATH=uploads/
ALLOWED_FILE_TYPES=pdf,doc,docx

# Email Configuration (for notifications)
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# OpenAI Configuration (for AI features)
OPENAI_API_KEY=your-openai-api-key

# External Services
CLOUDINARY_CLOUD_NAME=your-cloudinary-name
CLOUDINARY_API_KEY=your-cloudinary-key
CLOUDINARY_API_SECRET=your-cloudinary-secret

# Monitoring & Logging
LOG_LEVEL=info
SENTRY_DSN=your-sentry-dsn

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# CORS Configuration
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true