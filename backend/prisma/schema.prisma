// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Users table (integrated with Neon Auth)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  firstName String?  @map("first_name")
  lastName  String?  @map("last_name")
  avatar    String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  masterResumes   MasterResume[]
  jobDescriptions JobDescription[]
  applications    Application[]
  userPreferences UserPreferences?

  @@map("users")
}

// User Preferences
model UserPreferences {
  id                    String  @id @default(cuid())
  userId                String  @unique @map("user_id")
  theme                 String  @default("light")
  defaultResumeTemplate String? @map("default_resume_template")
  aiSuggestionsEnabled  Boolean @default(true) @map("ai_suggestions_enabled")
  emailNotifications    Boolean @default(true) @map("email_notifications")
  language              String  @default("en")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_preferences")
}

// Master Resumes
model MasterResume {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  title          String
  personalInfo   Json     @map("personal_info")
  skills         Json     @default("[]")
  experience     Json     @default("[]")
  education      Json     @default("[]")
  certifications Json     @default("[]")
  projects       Json     @default("[]")
  languages      Json     @default("[]")
  interests      Json     @default("[]")
  templateId     String?  @map("template_id")
  isDefault      Boolean  @default(false) @map("is_default")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // Relations
  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants ResumeVariant[]

  @@map("master_resumes")
}

// Job Descriptions
model JobDescription {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  companyName       String   @map("company_name")
  jobTitle          String   @map("job_title")
  jobDescription    String   @map("job_description")
  requirements      Json     @default("[]")
  extractedKeywords Json     @default("[]") @map("extracted_keywords")
  skillsRequired    Json     @default("[]") @map("skills_required")
  industry          String?
  location          String?
  salaryRange       String?  @map("salary_range")
  employmentType    String?  @map("employment_type") // full-time, part-time, contract
  experienceLevel   String?  @map("experience_level") // entry, mid, senior
  companySize       String?  @map("company_size")
  benefits          Json     @default("[]")
  sourceUrl         String?  @map("source_url")
  isArchived        Boolean  @default(false) @map("is_archived")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  // Relations
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variants     ResumeVariant[]
  applications Application[]

  @@map("job_descriptions")
}

// Resume Variants (Tailored Resumes)
model ResumeVariant {
  id               String   @id @default(cuid())
  masterResumeId   String   @map("master_resume_id")
  jobDescriptionId String   @map("job_description_id")
  tailoredContent  Json     @map("tailored_content")
  variantType      String   @map("variant_type") // 'conservative', 'aggressive', 'balanced'
  atsScore         Int?     @map("ats_score")
  feedback         Json     @default("[]") // ATS feedback and suggestions
  version          Int      @default(1)
  isGenerated      Boolean  @default(true) @map("is_generated")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  // Relations
  masterResume     MasterResume       @relation(fields: [masterResumeId], references: [id], onDelete: Cascade)
  jobDescription   JobDescription     @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  scoringResults   ATSScoringResult[]
  applications     Application[]
  exportedResumes  ExportedResume[]

  @@unique([masterResumeId, jobDescriptionId, variantType])
  @@map("resume_variants")
}

// ATS Scoring Results
model ATSScoringResult {
  id               String   @id @default(cuid())
  resumeVariantId  String   @map("resume_variant_id")
  keywordScore     Float    @map("keyword_score")
  skillsScore      Float    @map("skills_score")
  experienceScore  Float    @map("experience_score")
  formatScore      Float    @map("format_score")
  educationScore   Float    @map("education_score")
  overallScore     Float    @map("overall_score")
  recommendations  Json     @default("[]")
  detailedAnalysis Json     @default("{}") @map("detailed_analysis")
  scoringVersion   String   @default("1.0") @map("scoring_version")
  createdAt        DateTime @default(now()) @map("created_at")

  // Relations
  resumeVariant ResumeVariant @relation(fields: [resumeVariantId], references: [id], onDelete: Cascade)

  @@map("ats_scoring_results")
}

// Application Tracking
model Application {
  id               String             @id @default(cuid())
  userId           String             @map("user_id")
  jobDescriptionId String             @map("job_description_id")
  resumeVariantId  String?            @map("resume_variant_id")
  applicationDate  DateTime           @map("application_date")
  status           ApplicationStatus  @default(APPLIED)
  priority         ApplicationPriority @default(MEDIUM)
  notes            String?
  followUpDate     DateTime?          @map("follow_up_date")
  interviewDate    DateTime?          @map("interview_date")
  salary           String?
  contactInfo      Json               @default("{}") @map("contact_info")
  tags             Json               @default("[]")
  isArchived       Boolean            @default(false) @map("is_archived")
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  // Relations
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobDescription  JobDescription   @relation(fields: [jobDescriptionId], references: [id], onDelete: Cascade)
  resumeVariant   ResumeVariant?   @relation(fields: [resumeVariantId], references: [id], onDelete: SetNull)
  statusHistory   StatusHistory[]
  communications  Communication[]

  @@map("applications")
}

// Application Status History
model StatusHistory {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  status        ApplicationStatus
  notes         String?
  createdAt     DateTime          @default(now()) @map("created_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("status_history")
}

// Communication Log
model Communication {
  id            String            @id @default(cuid())
  applicationId String            @map("application_id")
  type          CommunicationType
  subject       String?
  content       String
  contactPerson String?           @map("contact_person")
  direction     String            // 'inbound', 'outbound'
  createdAt     DateTime          @default(now()) @map("created_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@map("communications")
}

// Exported Resumes (for tracking downloads)
model ExportedResume {
  id              String   @id @default(cuid())
  resumeVariantId String   @map("resume_variant_id")
  format          String   // 'pdf', 'docx', 'html'
  templateUsed    String?  @map("template_used")
  fileName        String   @map("file_name")
  fileSize        Int?     @map("file_size")
  downloadCount   Int      @default(0) @map("download_count")
  createdAt       DateTime @default(now()) @map("created_at")
  lastDownloaded  DateTime @default(now()) @map("last_downloaded")

  // Relations
  resumeVariant ResumeVariant @relation(fields: [resumeVariantId], references: [id], onDelete: Cascade)

  @@map("exported_resumes")
}

// Resume Templates
model ResumeTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   // 'modern', 'classic', 'creative', 'technical'
  preview     String?  // URL to preview image
  config      Json     @default("{}")
  isActive    Boolean  @default(true) @map("is_active")
  isPremium   Boolean  @default(false) @map("is_premium")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("resume_templates")
}

// System Analytics
model Analytics {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  event      String
  properties Json     @default("{}")
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("analytics")
}

// Enums
enum ApplicationStatus {
  APPLIED
  VIEWED
  INTERVIEW_SCHEDULED
  INTERVIEWED
  FOLLOW_UP
  OFFER_RECEIVED
  ACCEPTED
  REJECTED
  WITHDRAWN

  @@map("application_status")
}

enum ApplicationPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("application_priority")
}

enum CommunicationType {
  EMAIL
  PHONE
  IN_PERSON
  VIDEO_CALL
  MESSAGE
  OTHER

  @@map("communication_type")
}